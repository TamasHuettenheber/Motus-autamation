{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "JoriFlimmEpisodePayload",
  "type": "object",
  "additionalProperties": false,
  "required": ["date", "episode_number", "title", "hook", "narration", "riddle", "scenes", "publish_time", "qc"],
  "properties": {
    "date": {"type": "string", "format": "date"},
    "episode_number": {"type": "integer", "minimum": 0},
    "title": {"type": "string", "minLength": 3, "maxLength": 100},
    "hook": {"type": "string", "minLength": 3, "maxLength": 180},
    "narration": {"type": "string", "minLength": 30, "maxLength": 12000},
    "audio_url": {"type": "string", "format": "uri", "pattern": "^https://"},
    "voice": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model", "speaker_id"],
      "properties": {
        "model": {"const": "de_DE-mls-medium"},
        "speaker_id": {"const": 86}
      }
    },
    "riddle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "question", "answer", "pause_seconds"],
      "properties": {
        "type": {"type": "string", "enum": ["pattern", "counting", "logic", "direction", "word", "visual", "code"]},
        "question": {"type": "string", "minLength": 3},
        "answer": {"type": "string", "minLength": 1},
        "pause_seconds": {"type": "number", "minimum": 2, "maximum": 5}
      }
    },
    "scenes": {
      "type": "array",
      "minItems": 5,
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["order", "duration_seconds", "image_url"],
        "properties": {
          "order": {"type": "integer", "minimum": 1},
          "duration_seconds": {"type": "number", "minimum": 4, "maximum": 20},
          "image_url": {"type": "string", "format": "uri", "pattern": "^https://"},
          "caption": {"type": "string", "maxLength": 160}
        }
      }
    },
    "cta": {"type": "string", "maxLength": 200},
    "continuity_note": {"type": "string", "maxLength": 1000},
    "continuity_after": {
      "type": "object",
      "properties": {
        "relationship_stage": {"type": "string", "maxLength": 500},
        "known_facts": {"type": "array", "items": {"type": "string", "maxLength": 500}},
        "active_threads": {"type": "array", "items": {"type": "string", "maxLength": 500}}
      }
    },
    "publish_time": {"type": "string", "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"},
    "qc": {
      "type": "object",
      "additionalProperties": false,
      "required": ["book_spoiler_check", "continuity_check", "duplicate_check"],
      "properties": {
        "book_spoiler_check": {"const": true},
        "continuity_check": {"const": true},
        "duplicate_check": {"const": true}
      }
    }
  }
}
